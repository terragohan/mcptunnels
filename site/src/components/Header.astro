---
import DefaultHeader from '@astrojs/starlight/components/Header.astro';
---

<div class="terragohan-banner">
	<span>
		More chaos, bugs, and abandoned side projects at{' '}
		<a href="https://terragohan.com" target="_blank" rel="noopener">terragohan.com</a>.
	</span>
</div>
<DefaultHeader />

<style>
	.terragohan-banner {
		background: var(--sl-color-gray-6);
		color: var(--sl-color-gray-2);
		padding: 0.4rem 1rem;
		text-align: center;
		font-size: var(--sl-text-sm);
	}
	.terragohan-banner a {
		color: var(--sl-color-white);
		font-weight: 600;
		text-decoration: none;
	}
	.terragohan-banner a:hover {
		text-decoration: underline;
	}
</style>
