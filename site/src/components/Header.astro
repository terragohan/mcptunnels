---
import DefaultHeader from '@astrojs/starlight/components/Header.astro';
---

<div class="terragohan-header-strip">
	<a href="https://terragohan.com" target="_blank" rel="noopener">terragohan.com</a>
</div>
<DefaultHeader />

<style>
	.terragohan-header-strip {
		background: #ffffff;
		border-bottom: 1px solid #e5e5e5;
		text-align: center;
		padding: 0.25rem 1rem;
		font-size: 0.75rem;
		color: #737373;
	}
	.terragohan-header-strip a {
		color: #737373;
		text-decoration: none;
		font-family: var(--sl-font);
	}
	.terragohan-header-strip a:hover {
		color: #111111;
		text-decoration: underline;
	}
</style>
